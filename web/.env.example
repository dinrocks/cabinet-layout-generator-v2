# URL of the ezdxf service (DXF upload/export). Defaults to localhost:8000 if unset.
VITE_DXF_SERVICE_URL=http://localhost:8000

# Supabase (Phase 2). Leave BOTH blank to run the editor in local-only mode (no
# sign-in, no cloud projects). The anon key is publishable (safe in the browser).
# The service_role key is NEVER put here or in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
