# Comma-separated list of origins allowed to call the ezdxf service (CORS).
# Include your local editor and any deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# ── Phase 2 / Slice 2 (all optional; unset = local-only, open endpoint) ──
# Supabase project URL + SERVICE_ROLE key (server-side only — bypasses RLS).
# Used to store/read uploaded-DXF blocks in Supabase Storage so they survive restarts.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=equipment

# Supabase JWT secret (Settings → API → JWT secret). When set, /upload and /export
# require a valid Supabase access token; when blank the endpoints stay open (dev).
SUPABASE_JWT_SECRET=
